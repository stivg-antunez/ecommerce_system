<?xml version="1.0" encoding="UTF-8"?>

<xs:schema
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        targetNamespace="http://eccomerce.com/pedido"
        xmlns:tns="http://eccomerce.com/pedido"
        elementFormDefault="qualified">

    <xs:element name="obtenerPedidoRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element
                        name="id"
                        type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="obtenerPedidoResponse">
        <xs:complexType>
            <xs:sequence>

                <xs:element
                        name="id"
                        type="xs:long"/>

                <xs:element
                        name="cliente"
                        type="xs:string"/>

                <xs:element
                        name="estado"
                        type="xs:string"/>

                <xs:element
                        name="total"
                        type="xs:double"/>

            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>